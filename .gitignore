# RecallIQ .gitignore, grouped by what produces the files.
# frontend/ has its own .gitignore for Next.js specifics.

# --- Secrets: only the *.example templates are committed ------------------------
.env
.env.*
!.env.example
.envrc

# --- Private human annotations ---------------------------------------------------
# Personal, in-progress annotation files stay local. Reviewed annotation files are added
# deliberately (see data/annotations/README.md); templates and review evidence are tracked.
data/annotations/vd.jsonl

# --- Datasets: official CSV + generated corpus (rebuild with ml/recall_data) ------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model artifacts: checkpoints, embedding indexes, local runs ------------------
# Small run records (configs, histories, metrics, curves) are exported to experiments/.
ml/artifacts/
ml/runs/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# --- Python ----------------------------------------------------------------------
__pycache__/
*.py[codz]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# --- Node / Next.js ---------------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*

# --- Test and browser-automation artifacts ---------------------------------------
.playwright-mcp/
test-results/
playwright-report/

# --- OS / editor ------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
