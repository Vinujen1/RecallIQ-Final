# Copy to backend/.env and adjust. Never commit the real .env file.
RECALLIQ_ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
RECALLIQ_CORS_ORIGINS=http://localhost:3000
# SQLite file built by the data pipeline (default: <repo>/data/processed/recalliq.db).
# RECALLIQ_DATABASE_PATH=D:/path/to/recalliq.db
# MiniLM embedding artifacts (default: <repo>/ml/artifacts/embeddings/all-MiniLM-L6-v2).
# RECALLIQ_EMBEDDINGS_DIR=D:/path/to/embeddings
# Fine-tuned models (Model B / Model C): checkpoint dir + index built with it
# (`python -m retrieval.finetuned`). Defaults: ml/artifacts/models/model-{b,c}-v1/checkpoints/best
# and ml/artifacts/embeddings/model-{b,c}-v1. A missing/incompatible pair disables only that model.
# RECALLIQ_MODEL_B_CHECKPOINT=D:/path/to/model-b/checkpoints/best
# RECALLIQ_MODEL_B_EMBEDDINGS_DIR=D:/path/to/embeddings/model-b
# RECALLIQ_MODEL_C_CHECKPOINT=D:/path/to/model-c/checkpoints/best
# RECALLIQ_MODEL_C_EMBEDDINGS_DIR=D:/path/to/embeddings/model-c
# --- GPT-powered RAG answers (POST /explain) -------------------------------------------
# "openai" = GPT answer grounded in the retrieved notices, shown only if it passes the
# grounding guards; any error/timeout/failed check falls back to the deterministic template.
# "none" (code default) = deterministic template only, no network calls.
RECALLIQ_LLM_PROVIDER=openai
# Secret: keep it in backend/.env only (git-ignored). Never put it in frontend/.env.local.
# RECALLIQ_OPENAI_API_KEY is also accepted. Check with: python -m app.llm_check
OPENAI_API_KEY=
RECALLIQ_OPENAI_MODEL=gpt-4o-mini
# Per-request timeout (seconds) and retries for 429/5xx/connection errors.
RECALLIQ_LLM_TIMEOUT_SECONDS=15
RECALLIQ_LLM_MAX_RETRIES=1
# Upper bound on generated tokens per answer (answers are ~180 words).
RECALLIQ_LLM_MAX_OUTPUT_TOKENS=500
RECALLIQ_LLM_TEMPERATURE=0
# Results retrieved for /explain when the request omits top_k (1-5), and how many of those
# (after dropping identifier conflicts) are passed to the model as evidence (1-5).
RECALLIQ_RAG_TOP_K=5
RECALLIQ_RAG_MAX_EVIDENCE=3
# Log level of RecallIQ's own loggers (DEBUG, INFO, WARNING, ERROR). INFO shows one line per
# AI answer with the outcome and a rejection category; DEBUG also logs the rejected excerpt,
# which may echo what the user typed, so use it only while diagnosing.
RECALLIQ_LOG_LEVEL=INFO
